<?xml version="1.0" encoding="utf-8"?>
<!--
  دخول التبويب: الشاشة تُقبل من تحت قليلاً وتكبر إلى حجمها مع شفافية تصير كاملة،
  فتتحرّك الواجهة كلها حركة واحدة بدل أن تنقلب فجأة من شاشة لأخرى.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260"
    android:interpolator="@android:interpolator/fast_out_slow_in">

    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />

    <scale
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />

    <translate
        android:fromYDelta="5%p"
        android:toYDelta="0" />
</set>
