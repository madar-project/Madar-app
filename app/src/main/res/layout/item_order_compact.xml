<?xml version="1.0" encoding="utf-8"?>
<!--
  بطاقة طلب مصغّرة: واحد من «طلبات أخرى جارية». رقم الطلب أول السطر، وبعده اسم
  الزبون وسطر تحتو يجمع وقت الطلب بطريقة الاستلام، وبعده عدد الأصناف والسعر،
  وفي آخر السطر فعلين صغيرين لو الطلب لسه جديد.

  البطاقة اللي التاجر خلّص منها بيستبدل الزرارين بحبّة حالة واحدة، لأن كلمته قالت:
  القبول والرفض. ما بعده مش شغله، فمش بنديله زرار يحرّك حالة ما هو صاحبها.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_soft"
        android:fontFamily="@font/almarai_bold"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="@color/secondary_navy"
        android:textSize="14sp"
        tools:text="#2086" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/almarai_extra_bold"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            tools:text="أحمد سالم" />

        <TextView
            android:id="@+id/tvSubLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/almarai_regular"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="منذ 6 دقائق • توصيل سريع" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLinesCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_pill_soft"
        android:fontFamily="@font/almarai_bold"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/secondary_navy"
        android:textSize="12sp"
        tools:text="2 صنف" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/almarai_bold"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        tools:text="₪9.00" />

    <ImageView
        android:id="@+id/btnAccept"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_action_square"
        android:backgroundTint="@color/primary_orange"
        android:clickable="true"
        android:contentDescription="@string/order_accept"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_check"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/btnReject"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_action_square"
        android:backgroundTint="@color/section_light"
        android:clickable="true"
        android:contentDescription="@string/order_reject"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        app:tint="@color/danger_red" />

    <TextView
        android:id="@+id/tvStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_action_square"
        android:backgroundTint="@color/secondary_navy"
        android:fontFamily="@font/almarai_bold"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="قيد التحضير"
        tools:visibility="visible" />
</LinearLayout>
