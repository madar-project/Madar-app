<?xml version="1.0" encoding="utf-8"?>
<!--
  عنوان مجموعة اختيارات وما تحتها من أصناف. العنوان في الرسمة على اليمين والكلمة
  المفسّرة على يساره: «نوع الخبز» و«اختار 1»، أو «إضافات اختيارية» و«اختياري».

  الحاويتان تحتها لأن الشكلين مختلفان: الواحد بصفوف جنب بعضها، والمتعدد بصفوف
  فوق بعضها. تُملأ واحدة منهما بالكود وتبقى الأخرى فارغة فلا تأخذ مكاناً.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_group_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_extra_bold"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            tools:text="نوع الخبز" />

        <TextView
            android:id="@+id/tv_group_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/almarai_regular"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="@string/cust_sheet_pick_one" />
    </LinearLayout>

    <!-- صفوف الواحد: الكود يصفّ في كل صف بلاطتين كما في الرسمة، فالحاوية أعمدة لا صف -->
    <LinearLayout
        android:id="@+id/group_single"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/group_multi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />
</LinearLayout>
