<?xml version="1.0" encoding="utf-8"?>
<!-- مربّع إضافة صورة، يظهر في آخر المعرض ما بقيت خانة فارغة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="104dp"
    android:layout_columnWeight="1"
    android:layout_margin="4dp"
    android:background="@drawable/bg_add_photo"
    android:clickable="true"
    android:contentDescription="@string/btn_add_photo"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@string/btn_add_photo"
        android:src="@drawable/ic_camera"
        app:tint="@color/primary_orange" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/almarai_bold"
        android:text="@string/btn_add_photo"
        android:textColor="@color/primary_orange"
        android:textSize="12sp" />
</LinearLayout>
