<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشة تصفّح قسم: رأس باسم القسم، شريط تصنيفات أفقي، ولائحة بطاقات المتاجر.

  الاسم في الرأس هو اسم القسم كما في بطاقة الرئيسية، والشرائح تُبنى في الكود من
  التصنيفات الموجودة فعلاً في متاجر القسم، فلا شريحة توعد بمتاجر لا تصل.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- ============ الرأس ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tv_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/almarai_extra_bold"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:textSize="22sp" />

        <!-- TODO شاشة إشعارات الزبون لم يُسلَّم تصميمها بعد: الجرس ظاهر كما في الرسمة ولا يفتح شيئاً -->
        <ImageView
            android:id="@+id/iv_notifications"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/notif_title"
            android:src="@drawable/ic_notifications"
            app:tint="@color/primary_orange" />
    </LinearLayout>

    <!-- ============ شريط التصنيفات ============ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- ============ اللائحة ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_stores"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            tools:listitem="@layout/item_customer_store" />

        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_store"
                app:tint="@color/field_stroke" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/almarai_extra_bold"
                android:text="@string/cust_section_empty_title"
                android:textColor="@color/text_dark"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/almarai_regular"
                android:gravity="center"
                android:text="@string/cust_section_empty_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
