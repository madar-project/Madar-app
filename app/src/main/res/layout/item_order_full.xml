<?xml version="1.0" encoding="utf-8"?>
<!--
  بطاقة الطلب المفتوحة: أحدث طلب في الشريط المختار، وهي الوحيدة اللي بتعرض الأصناف
  واحد واحد والمجموع والزرارين الكبار. البطاقات اللي تحتها مصغّرات من نفس البيانات.

  الأيقونتان في آخر السطر (على الشمال) زي التصميم: الصح على حافة زرار القبول،
  والـ ✕ على حافة زرار الرفض، فاتنين بيبانوا قدام الإبهام من غير ما يلمسوا النص.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ===== الرأس: الرقم والشارة، وبعدهم الزبون وتليفونه ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/almarai_extra_bold"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            tools:text="#2088" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_peach"
            android:fontFamily="@font/almarai_bold"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/order_badge_new"
            android:textColor="@color/primary_orange"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/almarai_extra_bold"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            tools:text="ليلي حسن" />

        <ImageView
            android:id="@+id/btnCall"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="@string/order_call_customer"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/primary_orange" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/almarai_regular"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="اليوم 12:40 م" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/field_stroke" />

    <!-- ===== الأصناف: سطر لكل صنف، يُبنى في الكود من items ===== -->
    <LinearLayout
        android:id="@+id/llLines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp" />

    <!-- ===== المجموع ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_total_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_bold"
            android:text="@string/order_total_label"
            android:textColor="@color/text_dark"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/almarai_extra_bold"
            android:textColor="@color/primary_orange"
            android:textSize="18sp"
            tools:text="₪11.50" />
    </LinearLayout>

    <!-- ===== القبول والرفض ===== -->
    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_bold"
            android:text="@string/order_accept"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/primary_orange"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReject"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_bold"
            android:text="@string/order_reject"
            android:textAllCaps="false"
            android:textColor="@color/danger_red"
            android:textSize="15sp"
            app:backgroundTint="@color/section_light"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textEnd"
            app:iconTint="@color/danger_red" />
    </LinearLayout>
</LinearLayout>
