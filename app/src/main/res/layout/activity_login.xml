<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    android:layoutDirection="rtl"
    tools:context=".ui.auth.login.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="60dp"
        android:paddingBottom="24dp">

        <!-- العنوان الرئيسي -->
        <TextView
            android:id="@+id/tv_login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textColor="@color/text_dark"
            android:textSize="28sp"
            android:layout_gravity="center"
            android:fontFamily="@font/almarai_bold"
            android:layout_marginBottom="40dp" />

        <!-- 1. البريد الإلكتروني -->
        <TextView
            android:id="@+id/tv_label_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_email"
            android:textColor="@color/secondary_navy"
            android:textSize="15sp"
            android:fontFamily="@font/almarai_bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_login_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundMode="none"
            android:background="@drawable/bg_input_field"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="@color/text_secondary"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_login_email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@null"
                android:hint="@string/hint_email"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@._+-"
                android:textColorHint="#94A3B8"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:fontFamily="@font/almarai_regular"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:layoutDirection="ltr"
                android:textDirection="ltr"
                android:maxLength="80" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. كلمة المرور -->
        <TextView
            android:id="@+id/tv_label_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_password"
            android:textColor="@color/secondary_navy"
            android:textSize="15sp"
            android:fontFamily="@font/almarai_bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_login_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundMode="none"
            android:background="@drawable/bg_input_field"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/text_secondary"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/text_secondary"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_login_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@null"
                android:hint="@string/hint_password"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:textColorHint="#94A3B8"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:fontFamily="@font/almarai_regular"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- نسيت كلمة المرور -->
        <TextView
            android:id="@+id/tv_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="4dp"
            android:text="@string/login_forgot_password"
            android:textColor="@color/secondary_navy"
            android:textSize="13sp"
            android:fontFamily="@font/almarai_bold" />

        <!-- زر تسجيل الدخول -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_login"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/almarai_bold"
            app:backgroundTint="@color/primary_orange"
            app:cornerRadius="12dp"
            app:elevation="4dp" />

        <!-- نص الانتقال لإنشاء حساب -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_dont_have_account"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/almarai_regular" />

            <TextView
                android:id="@+id/tv_create_account_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/text_create_account_action"
                android:textColor="@color/secondary_navy"
                android:textSize="14sp"
                android:fontFamily="@font/almarai_bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
