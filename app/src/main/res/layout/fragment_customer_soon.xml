<?xml version="1.0" encoding="utf-8"?>
<!--
  صفحة موقتة لتبويب لم يُسلَّم رسمته بعد: اسم التبويب وعبارة صريحة أن مكانه محفوظ.

  لا أرقام مجمّلة ولا بيانات تجريبية هنا: الشاشة التي تُبنى على رسمة غير موجودة
  تضطر يومها لتغيير كل شيء، والأمانة للزبون أن يقول له إن هذه الشاشة بعدُ لم تُرسم.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingEnd="40dp">

    <ImageView
        android:id="@+id/iv_soon_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        app:tint="@color/field_stroke" />

    <TextView
        android:id="@+id/tv_soon_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/almarai_extra_bold"
        android:textColor="@color/text_dark"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/almarai_regular"
        android:gravity="center"
        android:text="@string/cust_soon_body"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
