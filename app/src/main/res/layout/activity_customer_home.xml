<?xml version="1.0" encoding="utf-8"?>
<!--
  مضيفة تبويبات الزبون: حاوية واحدة وشريط أسفلها، مثل مضيفة التاجر تماماً.
  التبويبات صفحات لا شاشات مستقلة، فتحريك صفحة محل أخرى داخل الحاوية يبقي الشريط
  مكانه ويترك زر الرجوع في الجهاز يخرج من التطبيق كله بدل أن يقلّب التبويبات.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ============ شريط التبويبات ============ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_customer_nav" />
</LinearLayout>
