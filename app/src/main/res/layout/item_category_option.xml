<?xml version="1.0" encoding="utf-8"?>
<!--
  سطر تصنيف واحد في لوحة الاختيار. الوعاء مش Chip ولا CheckedTextView، لأن الحالة
  واحدة فقط وهي «هذا المختار»، فيكفي setSelected الذي يحرّك الخلفية ولون النص معاً،
  وعلامة الصح بتجي في آخر السطر، على يسار الشاشة العربية.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginStart="6dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_picker_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/tvOption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/almarai_bold"
        android:maxLines="1"
        android:textColor="@color/picker_row_text"
        android:textSize="15sp"
        tools:text="حلويات" />

    <ImageView
        android:id="@+id/ivMark"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="@color/primary_orange"
        tools:visibility="visible" />
</LinearLayout>
