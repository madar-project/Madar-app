<?xml version="1.0" encoding="utf-8"?>
<!--
    شاشة إشعارات التاجر: رأس بجرس، وشرائح تقسم الطلبات عن المتجر والنظام، ولائة بطاقات،
    وسطر «مسح الإشعارات السابقة» في أسفلها ثابت لا يذهب مع التمرير.

    الأرقام بين قوسين في الشرائح تُضبط في الكود مع كل تحميل، فعدّاد «الطلبات» يتبع
    إشعارات الطلبات وحدها لا اللائحة المعروضة.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- ============ الرأس ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/notif_title"
            android:src="@drawable/ic_notifications"
            app:tint="@color/primary_orange" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/almarai_extra_bold"
            android:text="@string/notif_title"
            android:textColor="@color/text_dark"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- ============ شرائح التقسيم ============ -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/almarai_bold"
            android:textColor="@color/chip_filter_text"
            android:textSize="14sp"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_filter_bg"
            app:chipStrokeWidth="0dp"
            tools:text="الكل (4)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_orders"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/almarai_bold"
            android:textColor="@color/chip_filter_text"
            android:textSize="14sp"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_filter_bg"
            app:chipStrokeWidth="0dp"
            tools:text="الطلبات (2)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_store"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/almarai_bold"
            android:textColor="@color/chip_filter_text"
            android:textSize="14sp"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_filter_bg"
            app:chipStrokeWidth="0dp"
            tools:text="المتجر والنظام (2)" />
    </com.google.android.material.chip.ChipGroup>

    <!-- ============ سطر القسم وتحديد الكل كمقروء ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_bold"
            android:text="@string/notif_last_alerts"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_all_read"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/almarai_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="40dp"
            android:text="@string/notif_mark_all_read"
            android:textColor="@color/primary_orange"
            android:textSize="14sp"
            app:icon="@drawable/ic_done_all"
            app:iconGravity="end"
            app:iconPadding="6dp"
            app:iconTint="@color/primary_orange" />
    </LinearLayout>

    <!-- ============ اللائحة وحالتها الفارغة ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_merchant_notification" />

        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/notif_empty_title"
                android:src="@drawable/ic_notifications_none"
                app:tint="@color/dot_inactive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/almarai_extra_bold"
                android:text="@string/notif_empty_title"
                android:textColor="@color/text_dark"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/almarai_regular"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/notif_empty_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============ مسح السابق ============ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_clear_previous"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/almarai_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/notif_clear_previous"
        android:textColor="@color/secondary_navy"
        android:textSize="15sp"
        app:icon="@drawable/ic_delete"
        app:iconGravity="end"
        app:iconPadding="6dp"
        app:iconTint="@color/secondary_navy" />
</LinearLayout>
