<?xml version="1.0" encoding="utf-8"?>
<!--
  تبويب المنيو عند التاجر: لائحة منتجات متجره وحده.
  اللائحة تُبنى في الكود بطاقة بطاقة لأن عددها مجهول، والتمرير الأفقي للشرائح منفصل
  عن التمرير الرأسي للمنتجات حتى لا يتنافسا على اللمسة نفسها.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:context=".ui.merchant.menu.MerchantMenuFragment">

    <!-- ============ الرأس: العنوان والجرس ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_extra_bold"
            android:text="@string/menu_title"
            android:textColor="@color/text_dark"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/iv_notifications"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/menu_notifications"
            android:src="@drawable/ic_notifications_none"
            app:tint="@color/primary_orange" />
    </LinearLayout>

    <!-- ============ الوصف وزرار الإضافة ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_bold"
            android:text="@string/menu_subtitle"
            android:textColor="@color/secondary_navy"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_product"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:fontFamily="@font/almarai_bold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/btn_add_product"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/primary_orange"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textEnd"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- ============ شرائح التصفية بالتصنيف، عليها عدد منتجات كل واحد ============
         المختارة برتقالي مصمت وغيرهما فاتح، فاللون وحده يبيّن أي تصنيف مُطبَّق الآن. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- ============ اللائحة ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:fontFamily="@font/almarai_regular"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/menu_empty"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/list_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
