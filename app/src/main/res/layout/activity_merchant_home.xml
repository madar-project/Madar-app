<?xml version="1.0" encoding="utf-8"?>
<!--
  واجهة التاجر: مضيفة fragments لا شاشة محتوى.
  كل ما فيها حاوية يتبدّل محتواها وشريط تبويبات يقرّر أي جزء يظهر، فالحافة العلوية
  وشريط النظام تُحسب هنا مرة واحدة، والشاشات الفرعية ما تعيد حسابها.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    tools:context=".ui.merchant.home.MerchantHomeActivity">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ============ شريط التبويبات ============ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_merchant_home_nav" />
</LinearLayout>
