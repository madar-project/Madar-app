<?xml version="1.0" encoding="utf-8"?>
<!--
    شاشة تعديل بيانات المتجر: تُفتح من تبويب الإعدادات على بيانات المتجر نفسه.
    مبنية على رسم المصمِّم لا على نموذج التسجيل: الشعار في دائرته وشارة الكاميرا على
    حافّته، والاسم مع ختم الاعتماد تحته حالته، ثم بطاقة واحدة فيها الاسم والهاتف
    والعنوان، وزر الحفظ في شريط أسفل الشاشة.
    الحقول الثلاثة تُملأ من الوثيقة في الكود، فلا نص هنا إلا التسميات. والهاتف يُعرض
    مقسّماً كما يقرؤه صاحبه، ويُخزَّن بالصيغة الدولية.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    tools:context=".ui.merchant.settings.EditStoreActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ============ الشعار: دائرته كلها زر لاختيار صورة ============ -->
            <FrameLayout
                android:id="@+id/box_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:contentDescription="@string/logo_description"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/section_light"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/logo_description"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/iv_logo_placeholder"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/logo_description"
                        android:src="@drawable/ic_store"
                        app:tint="@color/text_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- شارة الكاميرا: توحي بأن الدائرة كلها قابلة للضغط -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/bg_circle_orange">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/logo_description"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />
                </FrameLayout>
            </FrameLayout>

            <!-- ============ اسم المتجر وختم اعتماده، وتحته حالته ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_store_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/almarai_extra_bold"
                    android:maxLines="1"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    tools:text="مطعم التاج" />

                <ImageView
                    android:id="@+id/iv_verified"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/settings_verified"
                    android:src="@drawable/ic_verified_seal"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_portal_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/almarai_regular"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="بوابة إدارة الشريك - معتمد" />

            <!-- ============ البطاقة: الحقول الثلاثة التي تُعدّل ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_section_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_store"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/almarai_bold"
                    android:gravity="center_vertical"
                    android:text="@string/edit_section_title"
                    android:textColor="@color/secondary_navy"
                    android:textSize="17sp" />

                <!-- اسم المتجر كما يظهر للزبائن -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/edit_label_store_name"
                    android:textColor="@color/secondary_navy"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_store_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    app:boxBackgroundMode="none"
                    app:endIconDrawable="@drawable/ic_store"
                    app:endIconMode="custom"
                    app:endIconTint="@color/text_secondary"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_store_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@null"
                        android:fontFamily="@font/almarai_regular"
                        android:hint="@string/hint_store_name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLength="60"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- رقم الجوال والواتساب: هو رقم الحساب، لا رقم مستقل في وثيقة المتجر -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/edit_label_phone"
                    android:textColor="@color/secondary_navy"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    app:boxBackgroundMode="none"
                    app:endIconDrawable="@drawable/ic_phone"
                    app:endIconMode="custom"
                    app:endIconTint="@color/text_secondary"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@null"
                        android:fontFamily="@font/almarai_regular"
                        android:hint="@string/hint_phone"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:maxLength="20"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_secondary"
                        android:textDirection="ltr"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- العنوان وموقع الفرع -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/edit_label_address"
                    android:textColor="@color/secondary_navy"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    app:boxBackgroundMode="none"
                    app:endIconDrawable="@drawable/ic_location"
                    app:endIconMode="custom"
                    app:endIconTint="@color/primary_orange"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_address"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@null"
                        android:fontFamily="@font/almarai_regular"
                        android:hint="@string/hint_address"
                        android:imeOptions="actionDone"
                        android:inputType="textPostalAddress"
                        android:maxLength="120"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============ شريط الحفظ أسفل الشاشة ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/primary_orange"
            android:fontFamily="@font/almarai_extra_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/edit_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/almarai_regular"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/edit_cancel"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
