<?xml version="1.0" encoding="utf-8"?>
<!--
  نافذة سبب رفض الطلب: تطلع من تحت لمّا التاجر يضغط رفض، وما فيها طلب يرفض إلا
  بعد ما يختار سبب. السبب الأول مختار على طول كما في التصميم، والملاحظة اختيارية
  فوقه — لأن التاجر واقف على مطبخ مشغول، ومش وقته يكتب.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- ===== المقبض: بيقول إن النافذة بتنسحب ===== -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />

        <!-- ===== الرأس: علامة التنبيه والعنوان ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icon_square_danger"
                android:contentDescription="@string/reject_title"
                android:padding="14dp"
                android:src="@drawable/ic_error_badge" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/almarai_extra_bold"
                android:gravity="center"
                android:text="@string/reject_title"
                android:textColor="@color/text_dark"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/almarai_regular"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/reject_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- ===== الاختيارات الأربعة: وحدة مختارة، والحد واللون بيقولوا مين ===== -->
        <LinearLayout
            android:id="@+id/rowStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_option_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/ivStock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/reject_reason_stock"
                android:src="@drawable/ic_radio_on" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/reject_reason_stock"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvStockNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/almarai_regular"
                    android:text="@string/reject_reason_stock_note"
                    android:textColor="@color/primary_orange"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowBusy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_option_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/ivBusy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/reject_reason_busy"
                android:src="@drawable/ic_radio_off" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/reject_reason_busy"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvBusyNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/almarai_regular"
                    android:text="@string/reject_reason_busy_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowClosed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_option_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/ivClosed"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/reject_reason_closed"
                android:src="@drawable/ic_radio_off" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/reject_reason_closed"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvClosedNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/almarai_regular"
                    android:text="@string/reject_reason_closed_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_option_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/ivOther"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/reject_reason_other"
                android:src="@drawable/ic_radio_off" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/reject_reason_other"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvOtherNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/almarai_regular"
                    android:text="@string/reject_reason_other_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== الملاحظة الاختيارية ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/almarai_bold"
                android:text="@string/reject_note_label"
                android:textColor="@color/text_dark"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/almarai_regular"
                android:text="@string/reject_note_optional"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_lavender_field"
            android:fontFamily="@font/almarai_regular"
            android:gravity="start|top"
            android:hint="@string/reject_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="2"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ===== سطر الاسترجاع: اسم الزبون بيتكتب من الطلب نفسه ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/reject_refund_note"
                android:src="@drawable/ic_info_outline" />

            <TextView
                android:id="@+id/tvRefund"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/almarai_regular"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/secondary_navy"
                android:textSize="14sp"
                tools:text="سيتم إرجاع المبلغ المدفوع مباشرة إلى المحفظة الرقمية ليلي حسن." />
        </LinearLayout>

        <!-- ===== التراجع والإبقاء ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/almarai_bold"
            android:text="@string/reject_confirm"
            android:textAllCaps="false"
            android:textColor="@color/danger_red"
            android:textSize="16sp"
            app:backgroundTint="@color/badge_danger_light"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_thumb_down"
            app:iconGravity="textStart"
            app:iconTint="@color/danger_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/almarai_bold"
            android:text="@string/reject_cancel"
            android:textAllCaps="false"
            android:textColor="@color/secondary_navy"
            android:textSize="16sp"
            app:backgroundTint="@color/section_light"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
