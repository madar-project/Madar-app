<?xml version="1.0" encoding="utf-8"?>
<!--
  تبويب العروض عند التاجر: نموذج إنشاء عرض واحد، يفتح كلما داس التاجر التبويب.
  كل خانة فيه تُكتب في وثيقة offers كما تراها، وبطاقة المعاينة في أسفله هي نفسها
  ما سيقرؤه الزبون، فتتعبّأ من الاسم وقيمة الخصم مع كل حرف لا عند الحفظ.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:context=".ui.merchant.offers.MerchantOffersFragment">

    <!-- ============ الرأس: العنوان والجرس ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_extra_bold"
            android:text="@string/nav_offers"
            android:textColor="@color/text_dark"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/iv_notifications"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/menu_notifications"
            android:src="@drawable/ic_notifications_none"
            app:tint="@color/primary_orange" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ============ بطاقة النموذج ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ===== اسم العرض ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/almarai_bold"
                        android:text="@string/offer_name_label"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/almarai_bold"
                        android:text="@string/required_star"
                        android:textColor="@color/primary_orange"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_lavender_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/et_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/almarai_bold"
                        android:gravity="start|center_vertical"
                        android:hint="@string/hint_offer_name"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/offer_name_icon_description"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- ===== نوع الخصم ===== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/offer_type_label"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_lavender_field"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btn_type_percent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:clickable="true"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:fontFamily="@font/almarai_bold"
                        android:gravity="center"
                        android:text="@string/offer_type_percent"
                        android:textColor="@color/segment_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btn_type_fixed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/almarai_bold"
                        android:gravity="center"
                        android:text="@string/offer_type_fixed"
                        android:textColor="@color/segment_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ===== قيمة الخصم ===== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/almarai_bold"
                    android:text="@string/offer_value_label"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_lavender_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/et_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/almarai_bold"
                        android:gravity="start|center_vertical"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        tools:text="20" />

                    <TextView
                        android:id="@+id/tv_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/almarai_bold"
                        android:text="@string/percent_sign"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/offer_value_icon_description"
                        android:src="@drawable/ic_flame" />
                </LinearLayout>

                <!-- ===== المنتجات المشمولة ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/almarai_bold"
                        android:text="@string/offer_products_label"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btn_select_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_lavender_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/almarai_bold"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="@string/offer_select_all"
                        android:textColor="@color/secondary_navy"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- اختيار التصنيف: قائمة منبثقة، لأن ٣٠ منتجاً في شريط واحد بلا نهاية -->
                <LinearLayout
                    android:id="@+id/ll_category"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_lavender_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/tv_category"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/almarai_bold"
                        android:maxLines="1"
                        android:text="@string/offer_category_all"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/offer_category_hint"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_products"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleLine="false" />

                <TextView
                    android:id="@+id/tv_no_products"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/almarai_regular"
                    android:text="@string/offer_no_products"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- ===== التاريخان ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/almarai_bold"
                            android:text="@string/offer_start_label"
                            android:textColor="@color/text_dark"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_start_date"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_lavender_field"
                            android:clickable="true"
                            android:drawableEnd="@drawable/ic_calendar"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/text_secondary"
                            android:focusable="true"
                            android:fontFamily="@font/almarai_bold"
                            android:gravity="start|center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/text_dark"
                            android:textSize="15sp"
                            tools:text="2026-10-22" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/almarai_bold"
                            android:text="@string/offer_end_label"
                            android:textColor="@color/text_dark"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_end_date"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_lavender_field"
                            android:clickable="true"
                            android:drawableEnd="@drawable/ic_calendar"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/text_secondary"
                            android:focusable="true"
                            android:fontFamily="@font/almarai_bold"
                            android:gravity="start|center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/text_dark"
                            android:textSize="15sp"
                            tools:text="2026-10-25" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== معاينة بطاقة الزبون ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/almarai_bold"
                        android:text="@string/offer_preview_label"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/almarai_bold"
                        android:text="@string/offer_live"
                        android:textColor="@color/primary_orange"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_lavender_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_peach_square"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/offer_gift_icon_description"
                            android:src="@drawable/ic_gift" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_preview_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/almarai_extra_bold"
                            android:maxLines="1"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            tools:text="خصم نهاية الأسبوع" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/almarai_regular"
                            android:text="@string/offer_preview_note"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_preview_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_discount_pill"
                        android:fontFamily="@font/almarai_bold"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        tools:text="خصم 20%" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ زرار الإنشاء، خارج البطاقة كما في التصميم ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/almarai_bold"
                android:text="@string/btn_create_offer"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/primary_orange"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_add_circle"
                app:iconGravity="textEnd"
                app:iconTint="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
