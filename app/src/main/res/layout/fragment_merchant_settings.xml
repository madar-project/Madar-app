<?xml version="1.0" encoding="utf-8"?>
<!--
    تبويب الإعدادات لواجهة التاجر: حالته، بيانات متجره، وملفه والدعم.

    الرسمة عربية من اليمين لليسار، فكل سطر مرتّب بحيث يقع ما يجب أن يكون على يمين
    القارئ أولًا: العنوان ثم المسافة ثم الأيقونة في رأس الصفحة، والأيقونة ثم النص
    ثم الحالة والسهم في أسطر الدعم.

    لا شيء هنا يُكتب في التصميم: الاسم والعنوان والهاتف والشعار وحالة الاتصال كلها
    تُقرأ من وثيقة المتجر ووثيقة الحساب في الكود، والظاهر في tools:text للتجربة فقط.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- ============ الرأس: العنوان والجرس ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_extra_bold"
            android:text="@string/nav_settings"
            android:textColor="@color/text_dark"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/iv_notifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_row_sounds"
            android:padding="10dp"
            android:src="@drawable/ic_notifications_none"
            app:tint="@color/primary_orange" />
    </LinearLayout>

    <!-- ============ سطر حالة الاتصال: يُقرأ من وثيقة المتجر ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp">

        <View
            android:id="@+id/view_state_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_circle_orange" />

        <TextView
            android:id="@+id/tv_store_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/almarai_bold"
            android:textColor="@color/secondary_navy"
            android:textSize="15sp"
            tools:text="المتجر متصل ويستقبل الطلبات الآن" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ============ بيانات المتجر ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/almarai_extra_bold"
                    android:text="@string/settings_store_section"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/almarai_regular"
                    android:gravity="end"
                    android:text="@string/settings_store_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- الاسم والعنوان والهاتف: كتلة النص تسبق الشعار فتقع يمينه -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_store_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/almarai_extra_bold"
                                android:maxLines="1"
                                android:textColor="@color/text_dark"
                                android:textSize="20sp"
                                tools:text="مطعم التاج" />

                            <!-- ختم الاعتماد: يظهر لمّا تكون حالة الوثيقة معتمدة -->
                            <ImageView
                                android:id="@+id/iv_verified"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@string/settings_verified"
                                android:src="@drawable/ic_verified_seal"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:drawablePadding="6dp"
                            android:ellipsize="start"
                            android:fontFamily="@font/almarai_regular"
                            android:gravity="center_vertical"
                            android:maxLines="2"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_location"
                            app:drawableTint="@color/primary_orange"
                            tools:text="فلسطين، غزة - شارع الجامعة" />

                        <TextView
                            android:id="@+id/tv_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawablePadding="6dp"
                            android:fontFamily="@font/almarai_regular"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_secondary"
                            android:textDirection="rtl"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_phone"
                            app:drawableTint="@color/secondary_navy"
                            tools:text="+970 59 765 4321" />
                    </LinearLayout>

                    <!-- شعار المتجر وشارة المتجر الصغيرة تحتها -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@color/section_light"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/iv_logo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/logo_description"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_store"
                                app:tint="@color/text_secondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@null"
                            android:padding="5dp"
                            android:src="@drawable/ic_store"
                            app:tint="@color/secondary_navy" />
                    </FrameLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_store"
                    style="@style/Widget.Madar.SettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_edit_store"
                    app:icon="@drawable/ic_edit" />
            </LinearLayout>

            <!-- ============ الملف والدعم ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/almarai_extra_bold"
                android:text="@string/settings_support_section"
                android:textColor="@color/text_dark"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="6dp">

                <!-- سطر النغمة: حالته تُقرأ من الجهاز نفسه -->
                <LinearLayout
                    android:id="@+id/row_sounds"
                    style="@style/Widget.Madar.SettingsRow">

                    <FrameLayout style="@style/Widget.Madar.SettingsRowIcon">

                        <ImageView
                            style="@style/Widget.Madar.SettingsRowIconImage"
                            android:contentDescription="@string/settings_row_sounds"
                            android:src="@drawable/ic_volume_up"
                            app:tint="@color/secondary_navy" />
                    </FrameLayout>

                    <LinearLayout style="@style/Widget.Madar.SettingsRowText">

                        <TextView
                            style="@style/Widget.Madar.SettingsRowTitle"
                            android:text="@string/settings_row_sounds" />

                        <TextView
                            style="@style/Widget.Madar.SettingsRowSub"
                            android:text="@string/settings_row_sounds_sub" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_sounds_state"
                        style="@style/Widget.Madar.SettingsRowState"
                        android:text="@string/settings_state_active" />

                    <ImageView
                        style="@style/Widget.Madar.SettingsRowChevron"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_left" />
                </LinearLayout>

                <View style="@style/Widget.Madar.SettingsRowDivider" />

                <!-- سطر الدعم: يفتح محادثة واتساب على رقم الدعم -->
                <LinearLayout
                    android:id="@+id/row_support"
                    style="@style/Widget.Madar.SettingsRow">

                    <FrameLayout style="@style/Widget.Madar.SettingsRowIcon">

                        <ImageView
                            style="@style/Widget.Madar.SettingsRowIconImage"
                            android:contentDescription="@string/settings_row_support"
                            android:src="@drawable/ic_headset_support"
                            app:tint="@color/secondary_navy" />
                    </FrameLayout>

                    <LinearLayout style="@style/Widget.Madar.SettingsRowText">

                        <TextView
                            style="@style/Widget.Madar.SettingsRowTitle"
                            android:text="@string/settings_row_support" />

                        <TextView
                            style="@style/Widget.Madar.SettingsRowSub"
                            android:text="@string/settings_row_support_sub" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.Madar.SettingsRowChevron"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_left" />
                </LinearLayout>

                <View style="@style/Widget.Madar.SettingsRowDivider" />

                <!-- سطر السياسات: شاشة نص داخل التطبيق -->
                <LinearLayout
                    android:id="@+id/row_policies"
                    style="@style/Widget.Madar.SettingsRow">

                    <FrameLayout style="@style/Widget.Madar.SettingsRowIcon">

                        <ImageView
                            style="@style/Widget.Madar.SettingsRowIconImage"
                            android:contentDescription="@string/settings_row_policies"
                            android:src="@drawable/ic_policy_card"
                            app:tint="@color/secondary_navy" />
                    </FrameLayout>

                    <LinearLayout style="@style/Widget.Madar.SettingsRowText">

                        <TextView
                            style="@style/Widget.Madar.SettingsRowTitle"
                            android:text="@string/settings_row_policies" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.Madar.SettingsRowChevron"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_left" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ الخروج والإصدار ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.Madar.LogoutButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/btn_logout"
                app:icon="@drawable/ic_logout" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/almarai_regular"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="إصدار التطبيق 1.0 (مدار أعمال)" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
