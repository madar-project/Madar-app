<?xml version="1.0" encoding="utf-8"?><!--
    نقطة المؤشر النشطة: شريط برتقالي مستطيل مدوّر.
    مستخدم كـ app:tabBackground داخل TabLayout، لذلك لا بد من android:gravity="center"
    داخل layer-list حتى يرسم بحجمه الثابت ولا يتمطّ على مساحة التبويب.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="24dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_orange" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
