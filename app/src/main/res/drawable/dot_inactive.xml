<?xml version="1.0" encoding="utf-8"?><!--
    نقطة مؤشر غير نشطة: دائرة رمادية صغيرة.
    نفس سبب استخدام layer-list مع gravity="center": منع التمطّط داخل TabLayout.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/dot_inactive" />
        </shape>
    </item>
</layer-list>
