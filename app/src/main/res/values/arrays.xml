    </string-array>

    <!--
        تصنيفات المتاجر التي تدخل تحت كل قسم من أقسام الزبون.
        النصوص هنا هي قيم store_categories حرفياً، لأن التصنيف يُحفظ نصاً لا فهرساً،
        فتغيير تسمية تصنيف هناك يجب أن يُغيَّر معه هنا أيضاً حتى لا يفقد القسم متاجره.
        القسمان الأخيران بلا قائمة: مسار التوصيل الخاص والخدمات المهنية لم يُبنَ بعد.
    -->
    <string-array name="section_restaurants_categories">
        <item>مطاعم ومأكولات</item>
        <item>كافيه وحلويات</item>
    </string-array>

