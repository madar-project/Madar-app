<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- مطلوب لإرسال رموز التحقق وقراءة البيانات من Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Madar"
        tools:targetApi="31">
        <activity
            android:name=".ui.auth.role.UserTypeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.register.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.email.EmailVerificationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.pending.PendingReviewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.CustomerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.merchant.register.MerchantRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.merchant.home.MerchantHomeActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.merchant.menu.AddProductActivity"
            android:exported="false" />
        <activity
            android:name=".ui.merchant.settings.MerchantPoliciesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.merchant.settings.EditStoreActivity"
            android:exported="false" />
        <activity
            android:name=".ui.merchant.notifications.MerchantNotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>